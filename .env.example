# Copy to .env and fill in. .env is gitignored.

# Model provider used by the mediator to serve /v1/messages upstream.
# The agent NEVER sees this key — only the mediator does.
MODEL_PROVIDER=anthropic          # anthropic | bedrock
ANTHROPIC_API_KEY=

# Only used when MODEL_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_INFERENCE_PROFILE_PREFIX=us

# Postgres (hot trace store)
DATABASE_URL=postgresql+asyncpg://blackbox:blackbox@localhost:5432/blackbox

# S3 archive (immutable, long-term). Optional in local dev — recorder logs
# a warning and skips archival if unset.
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ENDPOINT=              # set for local minio/localstack

# Mediator <-> Recorder
RECORDER_URL=http://localhost:8010

# Session auth (local dev client credentials for the demo agent)
MEDIATOR_CLIENT_ID=demo-agent
MEDIATOR_CLIENT_SECRET=demo-secret-change-me
