# Copy to .env and fill in before `docker compose up -d --build`.

DOMAIN=demo.example.com

POSTGRES_PASSWORD=
MEDIATOR_CLIENT_SECRET=
BLACKBOX_OPERATOR_KEY=

MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=

MEDIATOR_CLIENT_ID=demo-agent

# Abuse guardrails (Section 8) — matter more here than local dev, since
# this is reachable by the whole internet.
DEMO_LIVE_RUNS_ENABLED=true
DEMO_RATE_LIMIT_MAX_RUNS=5
DEMO_RATE_LIMIT_WINDOW_SECONDS=3600

# Optional: only set these if you're also archiving to real S3 from a VPS
# deployment (most self-hosted demos will leave ARCHIVE_S3_BUCKET unset
# and rely on the recorder's local-disk archive fallback).
ARCHIVE_S3_BUCKET=
AWS_REGION=
